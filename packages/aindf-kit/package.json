{
  "name": "@aindf/kit",
  "version": "0.2.0-pilot.6",
  "private": true,
  "description": "AINDF v2 kit: conformance check, immutable DS bundle, ScreenSpec admission, Next.js codegen and a DS MCP server for any design system.",
  "type": "module",
  "license": "MIT",
  "author": "Oleg.Design (https://oleg.design)",
  "homepage": "https://github.com/0design/ai-native-design-framework#readme",
