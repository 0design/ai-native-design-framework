{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "design.oleg/aindf",
  "title": "AINDF",
  "description": "Read-only MCP server for one AINDF design-system bundle: look up what it offers, validate screens.",
  "repository": {
    "url": "https://github.com/0design/ai-native-design-framework",
    "source": "github",
    "subfolder": "packages/aindf-kit"
  },
  "websiteUrl": "https://github.com/0design/ai-native-design-framework",
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ai-native-design-framework/kit",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP server over stdio"
        },
        {
          "type": "positional",
          "valueHint": "bundle_path",
          "description": "Path to the design system's AINDF bundle (made with `aindf bundle`)",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
